{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GenAI Protector Plus",
  "description": "Runtime AI security for GenAI and agentic AI workloads — official documentation, deployment guides, and API reference for CloudsineAI's GenAI Protector Plus.",
  "colors": {
    "primary": "#1F3864",
    "light": "#00B5E2",
    "dark": "#0F1E3A"
  },
  "favicon": "/logo/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://www.cloudsine.tech"
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
